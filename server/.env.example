# Una variabile impostata qui VINCE sulle Impostazioni dell'app e blocca quel campo nella UI
# ("dal server"). Per questo i campi facoltativi sono commentati: togli il # solo se vuoi
# fissarli dal server. Una variabile vuota (KEY=) conta come non impostata.

# ── Engine ──────────────────────────────────────────────────────────────────
# "gemini" (Google, free) · "groq" (Llama, free) · "openrouter" (:free models,
# free) · "claude" (Anthropic, paid). Default: gemini.
# SAMS_PROVIDER=gemini
# SAMS_MODEL=gemini-2.5-flash
# Gemini API key (free) from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only needed when SAMS_PROVIDER=groq (free) — from https://console.groq.com
GROQ_API_KEY=
# Only needed when SAMS_PROVIDER=openrouter (free) — from https://openrouter.ai/keys
# Use a ":free" tool-capable model in SAMS_MODEL, e.g.
# nvidia/nemotron-3-ultra-550b-a55b:free (the free catalog rotates — swap if needed).
OPENROUTER_API_KEY=
# Only needed when SAMS_PROVIDER=claude:
ANTHROPIC_API_KEY=

# ── GitHub ──────────────────────────────────────────────────────────────────
# Fine-grained Personal Access Token with "Contents: Read and write" (and
# "Pull requests: Read and write" if you want PRs) on the target repo.
# GITHUB_TOKEN=github_pat_...
GITHUB_TOKEN=
# owner/repo the agents work on.
# GITHUB_REPO=owner/repo
# GITHUB_BASE_BRANCH=main

# ── Managed Agents resources (filled in by `npm run setup`) ─────────────────
SAMS_AGENT_ID=
SAMS_ENVIRONMENT_ID=

# ── Notion (optional) ───────────────────────────────────────────────────────
# Internal integration secret from https://www.notion.so/my-integrations
# (and SHARE the target page with that integration). When set, every completed
# task is logged to the page below.
NOTION_TOKEN=
# Page URL or ID to append task logs to (e.g. your "Registro Agente & Changelog").
NOTION_PAGE_ID=

# ── Database (accounts, sessions, chat, world, routines, history) ────────────
# Unset: a SQLite file (.sams-data.db) in SAMS_DATA_DIR — fine for local use, but on a
# host without a persistent disk it is wiped on every restart.
# Set: MySQL 8 holds everything, so the server's disk can be thrown away. If it is set
# and unreachable, the runtime refuses to start (it never falls back to SQLite).
# Moving an existing SQLite file over: `npm run db:to-mysql` (target must be empty).
SAMS_DB_URL=
# e.g. SAMS_DB_URL=mysql://sams:password@localhost:3306/sams
# Add ?ssl-mode=REQUIRED for TLS with the system CAs; for a provider CA (e.g. Aiven)
# put the PEM (or a path to it) here instead:
SAMS_DB_SSL_CA=
# Contract tests against a real MySQL (the database is WIPED: its name must contain "test"):
# SAMS_TEST_DB_URL=mysql://root:password@localhost:3306/sams_test

# ── Commit Garden (optional MySQL; in-memory if unset) ──────────────────────
# The garden reuses GITHUB_TOKEN above. Set these only for persistence.
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sams_garden

# ── Account emails: password reset + address verification (optional) ────────
# Leave everything here empty and SAMS still works: sign-up gets you straight in and a
# forgotten password is recovered from the owner, who issues a one-time reset link from
# the profile page and hands it over (it is printed in the server logs too).
#
# Fill in ONE channel and two things switch on by themselves: "Forgot password?" mails
# the link, and new sign-ups must confirm their address before logging in.
# Public origin your users actually open — the links in the emails are built from it.
SAMS_PUBLIC_URL=http://localhost:5173
SAMS_MAIL_FROM=
# Option A — SMTP (port defaults to 587; 465 implies TLS, or force SMTP_SECURE=true).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
# Option B — Resend API (ignored when SMTP_HOST is set).
RESEND_API_KEY=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8787
# Set to "false" to skip automatic PR creation after a task.
# SAMS_OPEN_PRS=true
