# Server port
PORT=8088

# Optional GitHub token — raises the public API rate limit (60/h → 5000/h).
# Works without it for light use.
GITHUB_TOKEN=

# MySQL (optional). If unset or unreachable, Commit Garden falls back to an
# in-memory store so it still runs for development.
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=commit_garden
